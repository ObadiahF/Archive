# Copy to .env and fill in. Never commit .env.

# Single-user credentials for the file manager.
AUTH_USERNAME=obadiah
AUTH_PASSWORD=change-me

# Secret used to sign JWTs. Generate something long and random, e.g.:
#   openssl rand -hex 48
JWT_SECRET=replace-with-a-long-random-string
JWT_TTL_HOURS=24

# Upload limits.
MAX_FILE_BYTES=104857600
MAX_FILES_PER_REQUEST=20

# Host port the web UI is exposed on.
FRONTEND_PORT=8080

# Where uploaded files live on the host machine.
# Default is ./data next to this file. On Windows you can use absolute paths like
#   STORAGE_HOST_PATH=C:/Users/Obadiah/FileManagerStorage
STORAGE_HOST_PATH=./data
